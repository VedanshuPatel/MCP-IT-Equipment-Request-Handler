# Configuration template. Copy to `.env` and fill in real values.
# `.env` is git-ignored: never commit real keys or endpoints.
# The phase in brackets is when the application starts reading each group.

# --- MCP server [Phase 2] ---
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# --- Mock data [Phase 3] ---
DATA_DIR=./data

# --- Microsoft Foundry LLM [Phase 7] ---
FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1
FOUNDRY_API_KEY=<your-api-key>
FOUNDRY_DEPLOYMENT=gpt-6-astra
# Optional: retries for a failed Foundry request before switching to the fallback [Phase 12].
FOUNDRY_MAX_RETRIES=2

# --- Agent [Phase 8] ---
AGENT_MAX_STEPS=8

# --- Observability [Phase 11] ---
OTEL_ENABLED=false

# --- Fallback LLM [Phase 12] ---
# Used when Foundry is unreachable, times out, is rate-limited or returns a server error.
# All optional: the values below are the defaults. To use another model, it must be a keyless,
# OpenAI-compatible Chat Completions endpoint that supports tool calling. No API key is ever needed.
FALLBACK_ENDPOINT=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
FALLBACK_MODEL=Qwen3.5-397B-A17B
# Retries for rate limits (429) and server errors; 8 waits up to about 40 seconds.
FALLBACK_MAX_RETRIES=8